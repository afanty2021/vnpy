# A股数据服务模块配置示例
#
# 此文件定义数据服务特有的配置项
# 全局配置（数据库、QMT、RPC、日志等）请使用 global_development.yaml
#
# 配置文件位置: .vntrader_china/config/data_{environment}.yaml

# Tushare 配置
tushare_token: ""  # 从环境变量 TUSHARE_TOKEN 读取，或在此填入
tushare_rate_limit: 200  # API 调用频率限制（次/分钟）
tushare_retry_times: 3  # 重试次数
tushare_retry_delay: 1  # 重试延迟（秒）

# 缓存配置
cache_bar_ttl: 300  # K线缓存 TTL（秒）
cache_tick_ttl: 30  # Tick 缓存 TTL（秒）
cache_info_ttl: 86400  # 基础信息缓存 TTL（秒）

# 增量更新配置
auto_update_enabled: true  # 是否启用增量更新
update_interval: 3600  # 更新间隔（秒）
update_start_time: "08:00"  # 更新开始时间
update_end_time: "20:00"  # 更新结束时间
