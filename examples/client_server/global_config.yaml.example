# 全局配置文件示例
#
# 此文件包含系统所有配置项
# 配置文件位置: .vntrader_china/config/global_{environment}.yaml
# {environment} 可以是: development（开发）、testing（测试）、production（生产）

# 运行环境
environment: development

# 数据库配置
database:
  mysql_host: localhost
  mysql_port: 3306
  mysql_user: vnpy
  mysql_password: ''
  mysql_database: vnpy_china
  redis_host: localhost
  redis_port: 6379
  redis_db: 0
  redis_password: ''
  pool_size: 5
  max_overflow: 10

# 日志配置
logging:
  level: INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
  format: '%(asctime)s - %(name)s - %(levelname)s - %(message)s'
  file_enabled: true
  file_path: logs/vnpy_china.log
  max_bytes: 10485760  # 10MB
  backup_count: 5
  console_enabled: true

# RPC 服务配置
rpc:
  rep_address: tcp://0.0.0.0:2014  # RPC 服务端监听地址（REP模式）
  pub_address: tcp://0.0.0.0:4102  # RPC 服务端监听地址（PUB模式）
  timeout: 5000

# QMT 交易接口配置
qmt:
  account_id: ''  # QMT 资金账号（必填）
  mini_path: 'D:/国金证券QMT交易端/userdata_mini/'  # miniQMT 路径
  session_id: 0  # QMT 会话ID（可选，多会话时使用）
  password: ''  # QMT 交易密码（可选，某些场景需要）

# 风控配置
risk:
  max_position_ratio: 0.8  # 最大持仓比例
  max_single_position_ratio: 0.2  # 单只股票最大持仓比例
  max_daily_loss_ratio: 0.05  # 单日最大亏损比例
  max_consecutive_losses: 5  # 最大连续亏损次数

# 工作目录配置
work_dir: .vntrader_china
data_dir: data
