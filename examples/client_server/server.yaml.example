# Windows服务端配置文件模板
# 运行在Windows上，连接本地QMT
#
# 使用方法：
# 1. 复制此文件为 server.yaml
# 2. 修改下面的配置项

# QMT交易接口配置（必须）
qmt:
  account_id: ''                    # QMT资金账号
  mini_path: ''                     # miniQMT路径，例如：D:/国金证券QMT交易端/userdata_mini/
  session_id: 0                     # 会话ID（可选，多会话时使用）
  password: ''                       # 交易密码（可选）

# RPC服务配置（服务端自动启用，供客户端连接）
rpc:
  rep_address: "tcp://0.0.0.0:2014" # REP模式监听地址（0.0.0.0允许外部连接）
  pub_address: "tcp://0.0.0.0:4102" # PUB模式监听地址
  timeout: 5000                      # 超时时间（毫秒）

# 可选：数据库配置（用于数据存储）
# database:
#   enabled: false
#   host: localhost
#   port: 3306
#   user: vnpy
#   password: ''
#   database: vnpy_china
